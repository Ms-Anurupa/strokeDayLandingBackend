NODE_ENV=production
PORT=5000

# Supabase: pooled connection (app) and direct connection (migrations)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"

# Long random string. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=12h

# Exact frontend origins allowed to call the API (comma separated, no trailing slash)
CORS_ORIGINS=https://strokeday.example.com,https://admin.strokeday.example.com

# Folder for uploaded videos. Must be on persistent disk.
UPLOAD_DIR=/var/www/strokeday/uploads
MAX_VIDEO_SIZE_MB=100

# Optional: reject participant registrations after this time (ISO 8601, leave empty to keep open)
PARTICIPANT_REGISTRATION_CLOSES_AT=
MIN_PARTICIPANT_AGE=18

# Number of reverse proxies in front of the app (Nginx = 1)
TRUST_PROXY=1
